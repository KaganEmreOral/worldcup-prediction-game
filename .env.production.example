# Copy to .env.production on the VPS and replace every CHANGE_ME value.
# Never commit .env.production to git.

# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# Database (used by Postgres container and backend)
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password

# Public site URL (no trailing slash)
DOMAIN=worldcupytu.org

# Backend
CORS_ORIGINS=https://worldcupytu.org,https://www.worldcupytu.org
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ENABLE_TESTING_TOOLS=false

# Frontend build-time API base (must match public HTTPS URL)
NEXT_PUBLIC_API_URL=https://worldcupytu.org/api
